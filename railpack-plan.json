{
  "build": {
    "provider": "pip",
    "commands": [
      "pip install --no-cache-dir -r requirements.txt",
      "python manage.py collectstatic --noinput"
    ]
  },
  "deploy": {
    "startCommand": "python manage.py migrate --noinput && gunicorn jfd_hms.wsgi --bind 0.0.0.0:$PORT --workers 3 --timeout 120"
  }
}
