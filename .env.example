# ===========================================
# JFD Hospital Management System
# Environment Variables for Sevalla
# ===========================================
# Copy these keys into Sevalla > Application > Environmental variables
# Local development: copy this file to .env (it is git-ignored).

# --- Django Core ---
DJANGO_SECRET_KEY=change-me-to-a-real-random-64-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.sevalla.app,your-custom-domain.com
CSRF_TRUSTED_ORIGINS=https://your-app.sevalla.app,https://your-custom-domain.com

# --- Database (Sevalla provides DATABASE_URL for PostgreSQL) ---
# SQLite is used automatically for local dev when DATABASE_URL is unset.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Cloudinary (for Patient Photos + Hospital Logo) ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- CORS (set if a separate frontend domain calls this API) ---
CORS_ALLOWED_ORIGINS=https://your-app.sevalla.app,https://your-custom-domain.com

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=JFD Hospital <noreply@jfdhospital.gov.lr>
