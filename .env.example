# ===========================================
# JFD Hospital Management System
# Environment Variables for Railway
# ===========================================
# Copy these keys into Railway Dashboard > Variables tab

# --- Django Core ---
SECRET_KEY=change-me-to-a-real-random-64-char-string
DEBUG=False
ALLOWED_HOSTS=your-app.up.railway.app
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Cloudinary (for Patient Photos + Hospital Logo) ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://your-app.up.railway.app

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=JFD Hospital <noreply@jfdhospital.gov.lr>
